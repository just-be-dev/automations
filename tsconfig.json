{
  "$schema": "https://raw.githubusercontent.com/Effect-TS/language-service/refs/heads/main/schema.json",
  "compilerOptions": {
    "target": "ESNext",
    "lib": ["ESNext", "DOM"],
    "module": "Preserve",
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "noEmit": true,
    "strict": true,
    "skipLibCheck": true,
    "noUncheckedIndexedAccess": true,
    "paths": { "@/*": ["./src/ui/*"] },
    "types": ["@cloudflare/workers-types", "bun", "vite/client"],
    "plugins": [
      {
        "name": "@effect/language-service",
        "allowedDuplicatedPackages": ["effect-oxlint"],
        "overrides": [
          {
            "include": [
              "src/ui/main.ts",
              "src/ui/api.ts",
              "src/ui/entities/main.ts",
              "src/api.ts",
              "src/connection-runner.ts"
            ],
            "options": { "allowedUnstableApis": ["effect/http"] }
          },
          {
            "include": ["src/entity-mcp.ts", "src/entity-mcp.test.ts"],
            "options": { "allowedUnstableApis": ["effect/ai"] }
          },
          {
            "include": [
              "src/interpreter.ts",
              "src/interpreter.test.ts",
              "src/durable-engine.ts",
              "src/automation.ts"
            ],
            "options": { "allowedUnstableApis": ["effect/workflow"] }
          }
        ]
      }
    ]
  },
  "include": ["src/**/*.ts", "alchemy.run.ts", "oxlint.config.ts", "vite.config.ts"]
}
